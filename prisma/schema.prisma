generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userName String? @map("user_name")
  password String
  email String @unique
  role UserRole @default(normal) @map("user_role")
  subscription Boolean @default(false)
  news News[] 
  favoriteArtists FavoriteArtist[]
  favoriteGenres FavoriteGenre[]

  @@map("users")
}

model FavoriteArtist {
userId String 
artistId String 
user    User @relation(fields: [userId], references: [id])
artist Artist @relation(fields: [artistId], references: [id])

@@id([userId, artistId])
}

model FavoriteGenre {
userId String 
genreId String 
user    User @relation(fields: [userId], references: [id])
genre Genre @relation(fields: [genreId], references: [id])

@@id([userId, genreId])
}

model News {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title String
  status NewsStatus @default(not_approved)
  releaseDate DateTime? @map("release_date")
  category String
  content String
  user User @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  @@map("news")
}

model Artist {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artistName String @map("artist_name")
  biography String
  yearsOfLife String @map("years_of_life")

  arts Art[]
  awards Award[]
  schools School[]
  communities Community[]
  favoriteArtists FavoriteArtist[]

  @@map("artists")
}

model Award{
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  awardName String @map("award_name")
  awardDescription String @map("award_description")

  artists Artist[]

  @@map("awards")
}

model School{
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schoolName String @map("school_name")
  schoolDescription String @map("school_description")

  artists Artist[]

  @@map("schools")
}

model Community {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  communityName String @map("community_name")
  communityDescription String @map("community_description")

  artists Artist[]
  exhibitions Exhibition[]

  @@map("communities")
}

model Art {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artName String @map("art_name")
  artImage String @map("art_image")
  artDescription String  @map("art_description")
  productionYear String @map("production_year")
  materials Materials?
  measurements String
  cost Int?
  salesHistory String? @map("sales_history")

  genre Genre @relation(fields: [genreId], references: [id])
  genreId String @map("genre_id")
  museum Museum? @relation(fields: [museumId], references: [id])
  museumId String? @map("museum_id")
  artist Artist @relation(fields: [artistId], references: [id])
  artistId String @map("artist_id")
  exhibitions Exhibition[]

  @@map("arts")
}

model Genre {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  genreName String @map("genre_name")
  genreDescription String? @map("genre_description")

  arts Art[]
  favoriteGenres FavoriteGenre[]

  @@map("genres")
}
model Exhibition{
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exhibitionName String @map("exhibition_name")
  exhibitionDescription String @map("exhibition_description")
  community Community[]

  arts Art[]

  @@map("exhibitions")
}

model Museum{
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  museumName String @map("museum_name")
  museumDescription String @map("museum_description")

  arts Art[]

  @@map("museums")
}

enum UserRole {
   normal
   premium
   admin
}

enum Materials {
   painting @map("Живопись")
   graphic @map("Графика")
   hybrid @map("Смешанное")
}

enum NewsStatus{
   not_approved
   approved
}